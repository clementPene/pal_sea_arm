<launch>
  <arg name="robot_description" default="robot_description"/>
  <arg name="end_effector" default="false"/>
  <arg name="ft_sensor" default="false"/>
  <arg name="arm_model" default="pal-sea-arm-standalone"/>

  <!-- robot description -->
  <param name="$(arg robot_description)" 
         command="rosrun xacro xacro --inorder 
         '$(find pal_sea_arm_description)/robots/pal_sea_arm.urdf.xacro' arm_model:=$(arg arm_model) ft_sensor:=$(arg ft_sensor) end_effector:=$(arg end_effector)"/>

</launch>
