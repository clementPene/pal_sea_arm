<launch>
  <arg name="robot_description" default="robot_description"/>
  <arg name="end_effector" default="false"/>
  <arg name="ft_sensor" default="false"/>
  <arg name="arm_model" default="tiago-pro"/>
  <arg name="test_suffix" value="$(arg arm_model)_$(arg ft_sensor)_$(arg end_effector)"/>
  <include file="$(find pal_sea_arm_description)/robots/upload.launch" pass_all_args="true"/>
  <include file="$(find urdf_test)/launch/test_urdf.launch">
    <arg name="get_description" value="true"/>
    <arg name="test_suffix" value="$(eval test_suffix.replace('-', '_'))"/>
  </include>
</launch>