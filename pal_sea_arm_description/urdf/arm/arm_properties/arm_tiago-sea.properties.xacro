    <inertial>
        <origin
        xyz="0 -0.0939 ${0.0329 * reflect}"
        rpy="0 0 0" />
        <mass
        value="0.66725" />
        <inertia
        ixx="8.7604E-04"
        ixy="1.8688E-07"
        ixz="${1.8174E-07 * reflect}"
        iyy="4.0580E-04"
        iyz="${1.3224E-04 * reflect}"
