        <mass
        value="0.99204" />
        <inertia
        ixx="1.3967E-03"
        ixy="1.0609E-04"
        ixz="${-4.2876E-05 * reflect}"
        iyy="8.5657E-04"
        iyz="${2.5436E-04 * reflect}"
        izz="1.4862E-03" />
    </inertial>
</xacro:macro>

<xacro:macro name="origin_joint_4" params="reflect">
    <origin xyz="0.05 0.02 ${-0.1651 * reflect}" rpy="${90 * reflect * deg_to_rad} ${-0 * reflect * deg_to_rad} ${-90 * deg_to_rad}" />
</xacro:macro>

<xacro:macro name="inertial_link_5" params="reflect">
    <inertial>
        <origin
        xyz="2.5984E-03 0 ${-0.1278 * reflect}"
        rpy="0 0 0" />
        <mass
