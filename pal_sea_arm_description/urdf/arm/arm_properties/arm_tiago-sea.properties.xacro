</xacro:macro>

<xacro:macro name="inertial_link_7" params="reflect">
    <inertial>
        <origin
        xyz="0 0 0"
        rpy="0 0 0" />
        <mass
        value="0.10189" />
        <inertia
        ixx="5.0821E-05"
        ixy="2.1963E-09"
        ixz="${-2.9579E-20 * reflect}"
        iyy="4.4927E-05"
