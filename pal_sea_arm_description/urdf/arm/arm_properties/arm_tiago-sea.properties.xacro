<robot xmlns:xacro="http://ros.org/wiki/xacro">

<xacro:macro name="inertial_link_1" params="reflect">
    <inertial>
        <origin
        xyz="0.1082 0.0106 ${0.0328 * reflect}"
        rpy="0 0 0" />
        <mass
        value="1.0267" />
        <inertia
        ixx="8.0603E-04" 
        ixy="-8.52034E-05"
        ixz="${-3.0124E-04 * reflect}"
        iyy="1.9301E-03"
        iyz="${1.9426E-05 * reflect}"
        izz="1.8484E-03" />
    </inertial>
</xacro:macro>

<xacro:macro name="inertial_link_2" params="reflect">
    <inertial>
        <origin
        xyz="-0.0941 2.6612E-04  ${0.0414 * reflect}"
        rpy="0 0 0" />
        <mass
        value="0.9496" />
        <inertia
        ixx="8.4202E-04"
        ixy="-5.7830E-06"
        ixz="${2.6145E-04 * reflect}"
        iyy="1.4185E-03"
        iyz="${-5.8148E-06 * reflect}"
        izz="1.4729E-03" />
    </inertial>
</xacro:macro>

<xacro:macro name="origin_joint_2" params="reflect">
    <origin xyz="0.13 0.0483 ${0.04* reflect}" rpy="${-90 * reflect * deg_to_rad} 0 ${180 * deg_to_rad}" />
</xacro:macro>

<xacro:macro name="inertial_link_3" params="reflect">
    <inertial>
        <origin
        xyz="0.0121 0.0151 ${-0.1344 * reflect}"
        rpy="0 0 0" />
        <mass
        value="1.0816" />
        <inertia
        ixx="2.4587E-03"
        ixy="-1.2107E-05"
        ixz="${2.1354E-04 * reflect}"
        iyy="2.7652E-03"
        iyz="${6.0550E-05 * reflect}"
        izz="9.3005E-04" />
    </inertial>
</xacro:macro>

<xacro:macro name="origin_joint_3" params="reflect">
        <origin xyz="-0.1549 0 ${0.05 * reflect}" rpy="0 ${90 * reflect * deg_to_rad} 0" />
</xacro:macro>

<xacro:macro name="inertial_link_4" params="reflect">
    <inertial>
        <origin
        xyz="0.018 -0.1025 ${0.0419 * reflect}"
