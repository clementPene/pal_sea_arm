<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Transmissions file -->
  <xacro:include filename="$(find pal_sea_arm_description)/urdf/arm/arm.transmission.xacro"/>

  <xacro:macro name="pal_sea_arm" params="name parent *origin arm_model reflect arm_1_offset arm_2_offset arm_3_offset arm_4_offset arm_5_offset arm_6_offset arm_7_offset
                                          no_safety_eps:=False joint_limits_file:='$(find pal_sea_arm_description)/urdf/arm/limits/arm_${arm_model}.limits.xacro'">
    <xacro:property name="arm_eps"       value="${0.00 if no_safety_eps else 0.07}"/>

    <!-- Joint Limits file -->
    <xacro:include filename="${joint_limits_file}"/>

    <xacro:if value="${arm_model in ['tiago-pro', 'pal-sea-arm-standalone']}">

      <!-- ARM 1 LINK -->
      <link name="${name}_1_link">
        <inertial>
          <origin
            xyz="0.0023908 0.015901 0.1545"
            rpy="0 0 0" />
          <mass
            value="1.0816" />
          <inertia
            ixx="0.0024426"
            ixy="2.3307E-05"
            ixz="5.9333E-05"
            iyy="0.0023089"
            iyz="-0.00020369"
            izz="0.00092843" />
        </inertial>
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh
              filename="package://pal_sea_arm_description/meshes/arm_tiago_pro/arm_1_link.stl" />
          </geometry>
          <material name="">
            <color rgba="0.29804 0.29804 0.29804 1" />
          </material>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="package://pal_sea_arm_description/meshes/arm_tiago_pro/arm_1_link_collision.stl" />
          </geometry>
        </collision>
      </link>
      <joint name="${name}_1_joint" type="revolute">
        <xacro:insert_block name="origin"/>
        <parent link="${parent}" />
        <child link="${name}_1_link" />
        <axis xyz="0 0 1" />
        <limit lower="${arm_1_joint_lb}" upper="${arm_1_joint_ub}" effort="${arm_1_max_effort}" velocity="${arm_1_max_velocity}" /> 

      </joint>
    
      <!-- ARM 2 LINK -->
      <link name="${name}_2_link">
        <inertial>
          <origin
            xyz="-0.11649 -0.017864 0.0053772"
            rpy="0 0 0" />
          <mass
            value="0.99204" />
          <inertia
            ixx="0.00077294"
            ixy="-0.00011001"
            ixz="-0.00016136"
            iyy="0.0014605"
            iyz="-1.3224E-05"
            izz="0.0015605" />
        </inertial>
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="package://pal_sea_arm_description/meshes/arm_tiago_pro/arm_2_link.stl" />
          </geometry>
          <material name="">
            <color rgba="0.29804 0.29804 0.29804 1" />
          </material>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="package://pal_sea_arm_description/meshes/arm_tiago_pro/arm_2_link_collision.stl" />
          </geometry>
        </collision>
      </link>
    
      <!-- ARM 2 JOINT -->
      <joint name="${name}_2_joint" type="revolute">
        <origin xyz="0.0 0.02 0.18" rpy="0 1.5708 0" />
        <parent link="${name}_1_link" />
        <child link="${name}_2_link" />
        <axis xyz="0 0 1" />
        <limit lower="${arm_2_joint_lb}" upper="${arm_2_joint_ub}" effort="${arm_2_max_effort}" velocity="${arm_2_max_velocity}" />
      </joint>
    
      <!-- ARM 3 LINK -->
      <link name="${name}_3_link">
        <inertial>
          <origin
            xyz="0.0023908 0.015901 0.1545"
            rpy="0 0 0" />
          <mass
            value="1.0816" />
          <inertia
            ixx="0.0024426"
            ixy="2.3307E-05"
            ixz="5.9333E-05"
            iyy="0.0023089"
            iyz="-0.00020369"
            izz="0.00092843" />
        </inertial>
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="package://pal_sea_arm_description/meshes/arm_tiago_pro/arm_3_link.stl" />
          </geometry>
          <material name="">
            <color rgba="0.29804 0.29804 0.29804 1" />
          </material>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="package://pal_sea_arm_description/meshes/arm_tiago_pro/arm_3_link_collision.stl" />
          </geometry>
        </collision>
      </link>
    
      <!-- ARM 3 JOINT -->
      <joint name="${name}_3_joint" type="revolute">
        <origin
        xyz="-0.15 -0.02 0"
        rpy="3.1415 1.5707 0" />
        <parent link="${name}_2_link" />
        <child link="${name}_3_link" />
        <axis xyz="0 0 1" />
        <limit lower="${arm_3_joint_lb}" upper="${arm_3_joint_ub}" effort="${arm_3_max_effort}" velocity="${arm_3_max_velocity}" />
      </joint>
    
      <!-- ARM 4 LINK -->
      <link name="${name}_4_link">
        <inertial>
          <origin
            xyz="-0.11649 -0.017864 0.0053772"
            rpy="0 0 0" />
          <mass
            value="0.99204" />
          <inertia
            ixx="0.00077294"
            ixy="-0.00011001"
            ixz="-0.00016136"
            iyy="0.0014605"
            iyz="-1.3224E-05"
            izz="0.0015605" />
        </inertial>
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="package://pal_sea_arm_description/meshes/arm_tiago_pro/arm_4_link.stl" />
          </geometry>
          <material name="">
            <color rgba="0.29804 0.29804 0.29804 1" />
          </material>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="package://pal_sea_arm_description/meshes/arm_tiago_pro/arm_4_link_collision.stl" />
          </geometry>
        </collision>
      </link>
    
      <!-- ARM 4 JOINT -->
      <joint name="${name}_4_joint" type="revolute">
        <origin xyz="0 0.02 0.18" rpy="0 1.5708 0" />
        <parent link="${name}_3_link" />
        <child link="${name}_4_link" />
        <axis xyz="0 0 -1" />
        <limit lower="${arm_4_joint_lb}" upper="${arm_4_joint_ub}" effort="${arm_4_max_effort}" velocity="${arm_4_max_velocity}" />
      </joint>
    
      <!-- ARM 5 LINK -->
      <link name="${name}_5_link">
        <inertial>
          <origin
            xyz="0.0004859 0.00014289 0.129"
            rpy="0 0 0" />
          <mass
            value="0.52538" />
          <inertia
            ixx="0.0019111"
            ixy="-1.4245E-08"
            ixz="3.8663E-05"
            iyy="0.0018565"
            iyz="1.1356E-06"
            izz="0.00046496" />
        </inertial>
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="package://pal_sea_arm_description/meshes/arm_tiago_pro/arm_5_link.stl" />
          </geometry>
          <material name="">
            <color rgba="0.29804 0.29804 0.29804 1" />
          </material>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="package://pal_sea_arm_description/meshes/arm_tiago_pro/arm_5_link_collision.stl" />
          </geometry>
        </collision>
      </link>
    
      <!-- ARM 5 JOINT -->
      <joint name="${name}_5_joint" type="revolute">
        <origin xyz="-0.15 -0.02 0" rpy="0 -1.5708 0" />
        <parent link="${name}_4_link" />
        <child link="${name}_5_link" />
        <axis xyz="0 0 1" />
        <limit lower="${arm_5_joint_lb}" upper="${arm_5_joint_ub}" effort="${arm_5_max_effort}" velocity="${arm_5_max_velocity}" />
      </joint>
    
      <!-- ARM 6 LINK -->
      <link name="${name}_6_link">
        <inertial>
          <origin
            xyz="-0.086822 -7.7905E-06 0.0045258"
            rpy="0 0 0" />
          <mass
            value="0.66725" />
          <inertia
            ixx="0.00035696"
            ixy="1.6019E-07"
            ixz="-9.5191E-05"
            iyy="0.00073846"
            iyz="2.118E-08"
            izz="0.00075321" />
        </inertial>
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="package://pal_sea_arm_description/meshes/arm_tiago_pro/arm_6_link.stl" />
          </geometry>
          <material name="">
            <color rgba="0.29804 0.29804 0.29804 1" />
          </material>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="package://pal_sea_arm_description/meshes/arm_tiago_pro/arm_6_link_collision.stl" />
          </geometry>
        </collision>
      </link>
    
      <!-- ARM 6 JOINT -->
      <joint name="${name}_6_joint" type="revolute">
        <origin xyz="0 0 0.185" rpy="0 1.5708 0" />
        <parent link="${name}_5_link" />
        <child link="${name}_6_link" />
        <axis xyz="0 0 1" />
        <limit lower="${arm_6_joint_lb}" upper="${arm_6_joint_ub}" effort="${arm_6_max_effort}" velocity="${arm_6_max_velocity}" />
      </joint>
    
      <!-- ARM 7 LINK -->
      <link name="${name}_7_link">
        <inertial>
          <origin
            xyz="-6.764E-18 -1.4549E-16 0.018549"
            rpy="0 0 0" />
          <mass
            value="0.10189" />
          <inertia
            ixx="5.1076E-05"
            ixy="-1.0899E-21"
            ixz="-5.93E-21"
            iyy="5.0882E-05"
            iyz="-8.5344E-21"
            izz="9.705E-05" />
        </inertial>
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="package://pal_sea_arm_description/meshes/arm_tiago_pro/arm_7_link.stl" />
          </geometry>
          <material name="">
            <color rgba="0.29804 0.29804 0.29804 1" />
          </material>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="package://pal_sea_arm_description/meshes/arm_tiago_pro/arm_7_link_collision.stl" />
          </geometry>
        </collision>
      </link>

      <!-- ARM 7 JOINT -->
      <joint name="${name}_7_joint" type="revolute">
        <origin
        xyz="-0.1166 0 0"
        rpy="0 -1.5708 0" />
        <parent link="${name}_6_link" />
        <child link="${name}_7_link" />
        <axis xyz="0 0 1" />
        <limit lower="${arm_7_joint_lb}" upper="${arm_7_joint_ub}" effort="${arm_7_max_effort}" velocity="${arm_7_max_velocity}" />
      </joint>

      <!--***********************-->
      <!--        TOOL           -->
      <!--***********************-->
      <link name="${name}_tool_link">
        <inertial>
          <origin
            xyz="5.0493E-18 -4.4892E-17 -0.0068514"
            rpy="0 0 0" />
          <mass value="0.10189" />
          <inertia
            ixx="5.1076E-05"
            ixy="-1.0374E-21"
            ixz="-5.9164E-21"
            iyy="5.0882E-05"
            iyz="-8.5211E-21"
            izz="9.705E-05" />
        </inertial>
        <visual>
          <origin xyz="0.001 0 0" rpy="0 1.5708 0" />
          <geometry>
            <cylinder radius="0.005" length="0.005"/>
          </geometry>
          <material name="">
            <color rgba="0.29804 0.29804 0.29804 1" />
          </material>
        </visual>
        <collision>
          <origin xyz="0.001 0 0" rpy="0 1.5708 0" />
          <geometry>
            <cylinder radius="0.005" length="0.005"/>
          </geometry>
        </collision>
      </link>

      <joint name="${name}_tool_joint" type="fixed">
        <parent link="${name}_7_link" />
        <child link="${name}_tool_link" />
          <origin xyz="0 0 0.0184" rpy="0 ${-90.0 * deg_to_rad} ${90.0 * deg_to_rad}" />
      </joint>

    </xacro:if>

    <xacro:if value="${arm_model in ['tiago-sea', 'tiago-sea-dual']}">

      <!-- ARM 1 LINK -->
      <link name="${name}_1_link">
        <inertial>
          <origin xyz="0.1082 0.0106 ${0.0328 * reflect}" rpy="0 0 0" />
          <mass value="1.0267" />
        <inertia
          ixx="8.0603E-04" ixy="-8.52034E-05" ixz="${-3.0124E-04 * reflect}"
          iyy="1.9301E-03" iyz="${1.9426E-05 * reflect}"
          izz="1.8484E-03" />
        </inertial>
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="package://pal_sea_arm_description/meshes/arm_tiago_sea/arm_1_link.stl"
              scale="1 1 ${reflect}" />
          </geometry>
          <material
            name="">
            <color
              rgba="0.752941176470588 0.752941176470588 0.752941176470588 1" />
          </material>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh
              filename="package://pal_sea_arm_description/meshes/arm_tiago_sea/arm_1_link_convex.stl"
              scale="1 1 ${reflect}" />
          </geometry>
        </collision>
      </link>

      <!-- ARM 1 JOINT -->
      <joint name="${name}_1_joint" type="revolute">
        <xacro:insert_block name="origin" />
        <parent link="${parent}" />
        <child link="${name}_1_link" />
        <axis xyz="0 0 ${1}" />
        <limit lower="${arm_1_joint_lb * deg_to_rad}" upper="${arm_1_joint_ub * deg_to_rad}" effort="${arm_1_max_effort}" velocity="${arm_1_max_velocity}" />
        <dynamics friction="${arm_friction}" damping="${arm_damping}"/>
        <safety_controller k_position="${arm_k_position}" k_velocity="${arm_k_velocity}" soft_lower_limit="${arm_1_joint_lb * deg_to_rad  + arm_eps}"
          soft_upper_limit="${arm_1_joint_ub * deg_to_rad - arm_eps}" />
      </joint>

      <!-- ARM 2 LINK -->
      <link name="${name}_2_link">
        <inertial>
          <origin xyz="-0.0941 2.6612E-04  ${0.0414 * reflect}" rpy="0 0 0" />
          <mass value="0.9496" />
          <inertia
            ixx="8.4202E-04" ixy="-5.7830E-06" ixz="${2.6145E-04 * reflect}"
            iyy="1.4185E-03" iyz="${-5.8148E-06 * reflect}"
            izz="1.4729E-03" />
        </inertial>
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="package://pal_sea_arm_description/meshes/arm_tiago_sea/arm_2_link.stl"
              scale="1 1 ${reflect}" />
          </geometry>
          <material
            name="">
            <color
              rgba="0.752941176470588 0.752941176470588 0.752941176470588 1" />
          </material>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh
              filename="package://pal_sea_arm_description/meshes/arm_tiago_sea/arm_2_link_convex.stl"
              scale="1 1 ${reflect}" />
          </geometry>
        </collision>
      </link>

      <!-- ARM 2 JOINT -->
      <joint name="${name}_2_joint" type="revolute">
        <origin xyz="0.13 0.0483 ${0.04* reflect}"
          rpy="${-90 * reflect * deg_to_rad} 0 ${180 * deg_to_rad}" />
        <parent link="${name}_1_link" />
        <child link="${name}_2_link" />
        <axis xyz="0 0 1" />
        <limit lower="${arm_2_joint_lb * deg_to_rad}" upper="${arm_2_joint_ub * deg_to_rad}" effort="${arm_2_max_effort}" velocity="${arm_2_max_velocity}" />
        <dynamics friction="${arm_friction}" damping="${arm_damping}"/>
        <safety_controller k_position="${arm_k_position}" k_velocity="${arm_k_velocity}" soft_lower_limit="${arm_2_joint_lb * deg_to_rad  + arm_eps}"
          soft_upper_limit="${arm_2_joint_ub * deg_to_rad - arm_eps}" />
      </joint>

      <!-- ARM 3 LINK -->
      <link name="${name}_3_link">
        <inertial>
          <origin xyz="0.0121 0.0151 ${-0.1344 * reflect}"
            rpy="0 0 0" />
          <mass value="1.0676" />
          <inertia
            ixx="2.4587E-03" ixy="-1.2107E-05" ixz="${2.1354E-04 * reflect}"
            iyy="2.7652E-03" iyz="${6.0550E-05 * reflect}"
            izz="9.3005E-04" />
        </inertial>
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="package://pal_sea_arm_description/meshes/arm_tiago_sea/arm_3_link.stl"
              scale="1 1 ${reflect}" />
          </geometry>
          <material
            name="">
            <color
              rgba="0.752941176470588 0.752941176470588 0.752941176470588 1" />
          </material>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh
              filename="package://pal_sea_arm_description/meshes/arm_tiago_sea/arm_3_link_convex.stl"
              scale="1 1 ${reflect}" />
          </geometry>
        </collision>
      </link>

      <!-- ARM 3 JOINT -->
      <joint name="${name}_3_joint" type="revolute">
        <origin xyz="-0.1549 0 ${0.05 * reflect}"
          rpy="0 ${90 * reflect * deg_to_rad} 0" />
        <parent link="${name}_2_link" />
        <child
          link="${name}_3_link" />
        <axis xyz="0 0 1" />
        <limit lower="${arm_3_joint_lb * deg_to_rad}" upper="${arm_3_joint_ub * deg_to_rad}"
          effort="${arm_3_max_effort}" velocity="${arm_3_max_velocity}" />
        <dynamics friction="${arm_friction}" damping="${arm_damping}"/>
        <safety_controller k_position="${arm_k_position}" k_velocity="${arm_k_velocity}"
          soft_lower_limit="${arm_3_joint_lb * deg_to_rad  + arm_eps}"
          soft_upper_limit="${arm_3_joint_ub * deg_to_rad - arm_eps}" />
      </joint>

      <!-- ARM 4 LINK -->
      <link name="${name}_4_link">
        <inertial>
          <origin xyz="0.018 -0.1025 ${0.0419 * reflect}" rpy="0 0 0" />
          <mass value="0.9494" />
        <inertia
          ixx="1.3967E-03" ixy="1.0609E-04" ixz="${-4.2876E-05 * reflect}"
          iyy="8.5657E-04" iyz="${2.5436E-04 * reflect}"
          izz="1.4862E-03" />
        </inertial>
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="package://pal_sea_arm_description/meshes/arm_tiago_sea/arm_4_link.stl"
              scale="1 1 ${reflect}" />
          </geometry>
          <material
            name="">
            <color
              rgba="0.752941176470588 0.752941176470588 0.752941176470588 1" />
          </material>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh
              filename="package://pal_sea_arm_description/meshes/arm_tiago_sea/arm_4_link_convex.stl"
              scale="1 1 ${reflect}" />
          </geometry>
        </collision>
      </link>

      <!-- ARM 4 JOINT -->
      <joint name="${name}_4_joint" type="revolute">
        <origin xyz="0.05 0.02 ${-0.1651 * reflect}"
          rpy="${90 * reflect * deg_to_rad} ${-0 * reflect * deg_to_rad} ${-90 * deg_to_rad}" />
        <parent
          link="${name}_3_link" />
        <child link="${name}_4_link" />
        <axis xyz="0 0 1" />
        <limit
          lower="${arm_4_joint_lb * deg_to_rad}" upper="${arm_4_joint_ub * deg_to_rad}" effort="${arm_4_max_effort}" velocity="${arm_4_max_velocity}" />
        <dynamics friction="${arm_friction}" damping="${arm_damping}"/>

        <safety_controller
          k_position="${arm_k_position}" k_velocity="${arm_k_velocity}" soft_lower_limit="${arm_4_joint_lb * deg_to_rad  + arm_eps}"
          soft_upper_limit="${arm_4_joint_ub * deg_to_rad - arm_eps}" />
      </joint>

      <!-- ARM 5 LINK -->
      <link name="${name}_5_link">
        <inertial>
          <origin xyz="2.5984E-03 0 ${-0.1278 * reflect}" rpy="0 0 0" />
          <mass value="0.7489" />
          <inertia
            ixx="1.9033E-03" ixy="-4.8338E-07" ixz="${1.5833E-06 * reflect}"
            iyy="1.9678E-03" iyz="${-2.6173E-05 * reflect}"
            izz="7.0997E-04" />
        </inertial>
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="package://pal_sea_arm_description/meshes/arm_tiago_sea/arm_5_link.stl"
              scale="1 1 ${reflect}" />
          </geometry>
          <material
            name="">
            <color
              rgba="0.752941176470588 0.752941176470588 0.752941176470588 1" />
          </material>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh
              filename="package://pal_sea_arm_description/meshes/arm_tiago_sea/arm_5_link_convex.stl"
              scale="1 1 ${reflect}" />
          </geometry>
        </collision>
      </link>

      <!-- ARM 5 JOINT -->
      <joint name="${name}_5_joint" type="revolute">
        <origin xyz="0.02 -0.1546 ${0.05 * reflect}"
          rpy="${90 * reflect * deg_to_rad} 0 ${180 * deg_to_rad}" />
        <parent link="${name}_4_link" />
        <child
          link="${name}_5_link" />
        <axis xyz="0 0 1" />
        <limit
          lower="${arm_5_joint_lb * deg_to_rad}" upper="${arm_5_joint_ub * deg_to_rad}" effort="${arm_5_max_effort}" velocity="${arm_5_max_velocity}" />
        <dynamics friction="${arm_friction}" damping="${arm_damping}"/>

        <safety_controller
          k_position="${arm_k_position}" k_velocity="${arm_k_velocity}" soft_lower_limit="${arm_5_joint_lb * deg_to_rad  + arm_eps}"
          soft_upper_limit="${arm_5_joint_ub * deg_to_rad - arm_eps}" />
      </joint>

      <!-- ARM 6 LINK -->
      <link name="${name}_6_link">
        <inertial>
          <origin xyz="0 -0.0939 ${0.0329 * reflect}" rpy="0 0 0" />
          <mass value="0.7078" />
          <inertia
            ixx="8.7604E-04" ixy="1.8688E-07" ixz="${1.8174E-07 * reflect}"
            iyy="4.0580E-04" iyz="${1.3224E-04 * reflect}"
            izz="9.0318E-04" />
        </inertial>
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="package://pal_sea_arm_description/meshes/arm_tiago_sea/arm_6_link.stl"
              scale="1 1 ${reflect}" />
          </geometry>
          <material
            name="">
            <color
              rgba="0.752941176470588 0.752941176470588 0.752941176470588 1" />
          </material>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh
              filename="package://pal_sea_arm_description/meshes/arm_tiago_sea/arm_6_link_convex.stl"
              scale="1 1 ${reflect}" />
          </geometry>
        </collision>
      </link>

      <!-- ARM 6 JOINT -->
      <joint name="${name}_6_joint" type="revolute">
        <origin xyz="0 -0.0395 ${-0.1651 * reflect}"
          rpy="${90 * reflect * deg_to_rad} 0 ${180 * deg_to_rad}" />
        <parent link="${name}_5_link" />
        <child
          link="${name}_6_link" />
        <axis xyz="0 0 1" />
        <limit
          lower="${arm_6_joint_lb * deg_to_rad}" upper="${arm_6_joint_ub * deg_to_rad}" effort="${arm_6_max_effort}" velocity="${arm_6_max_velocity}" />
        <dynamics friction="${arm_friction}" damping="${arm_damping}"/>

        <safety_controller
          k_position="${arm_k_position}" k_velocity="${arm_k_velocity}" soft_lower_limit="${arm_6_joint_lb * deg_to_rad  + arm_eps}"
          soft_upper_limit="${arm_6_joint_ub * deg_to_rad - arm_eps}" />
      </joint>

      <!-- ARM 7 LINK -->
      <link name="${name}_7_link">
        <inertial>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <mass value="0.0933" />
          <inertia
            ixx="5.0821E-05" ixy="2.1963E-09" ixz="${-2.9579E-20 * reflect}"
            iyy="4.4927E-05" iyz="${-2.9712E-19 * reflect}"
            izz="9.1085E-05" />
        </inertial>
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="package://pal_sea_arm_description/meshes/arm_tiago_sea/arm_7_link.stl"
              scale="1 1 ${reflect}" />
          </geometry>
          <material
            name="">
            <color
              rgba="0.752941176470588 0.752941176470588 0.752941176470588 1" />
          </material>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh
              filename="package://pal_sea_arm_description/meshes/arm_tiago_sea/arm_7_link_convex.stl"
              scale="1 1 ${reflect}" />
          </geometry>
        </collision>
      </link>

      <!-- ARM 7 JOINT -->
      <joint name="${name}_7_joint" type="revolute">
        <origin xyz="0 -0.146 ${0.039 * reflect}"
          rpy="${-90 * reflect * deg_to_rad} 0 0" />
          <!-- rpy="0 ${90 * reflect * deg_to_rad} ${90 * deg_to_rad}" /> -->

        <parent link="${name}_6_link" />
        <child
          link="${name}_7_link" />
        <axis xyz="0 0 1" />
        <limit
          lower="${arm_7_joint_lb * deg_to_rad}" upper="${arm_7_joint_ub * deg_to_rad}" effort="${arm_7_max_effort}" velocity="${arm_7_max_velocity}" />
        <dynamics friction="${arm_friction}" damping="${arm_damping}"/>

        <safety_controller
          k_position="${arm_k_position}" k_velocity="${arm_k_velocity}" soft_lower_limit="${arm_7_joint_lb * deg_to_rad  + arm_eps}"
          soft_upper_limit="${arm_7_joint_ub * deg_to_rad - arm_eps}" />
      </joint>

      <!--***********************-->
      <!--        TOOL           -->
      <!--***********************-->
      <link name="${name}_tool_link">
        <inertial>
          <mass value="0.1" />
          <inertia ixx="8.33E-07" ixy="0.0" ixz="0.0" iyy="8.33E-07" iyz="0.0" izz="1.25E-06" />
        </inertial>
        <visual>
          <origin xyz="0.001 0 0" rpy="0 ${90.0 * deg_to_rad} 0" />
          <geometry>
            <cylinder radius="0.005" length="0.005"/>
          </geometry>
          <material name="LightGrey" />
        </visual>
        <collision>
          <origin xyz="0.001 0 0" rpy="0 ${90.0 * deg_to_rad} 0" />
          <geometry>
            <cylinder radius="0.005" length="0.005"/>
          </geometry>
        </collision>
      </link>

      <joint name="${name}_tool_joint" type="fixed">
        <parent link="${name}_7_link" />
        <child link="${name}_tool_link" />
        <origin xyz="0 0 0" rpy="${0.0 * deg_to_rad} ${90.0 * reflect * deg_to_rad} ${0 * deg_to_rad}" />
      </joint>
    </xacro:if>

    <gazebo reference="${name}_1_link">
      <mu1>0.9</mu1>
      <mu2>0.9</mu2>
    </gazebo>
    <gazebo reference="${name}_2_link">
      <mu1>0.9</mu1>
      <mu2>0.9</mu2>
    </gazebo>
    <gazebo reference="${name}_3_link">
      <mu1>0.9</mu1>
      <mu2>0.9</mu2>
    </gazebo>
    <gazebo reference="${name}_4_link">
      <mu1>0.9</mu1>
      <mu2>0.9</mu2>
    </gazebo>
    <gazebo reference="${name}_5_link">
      <mu1>0.9</mu1>
      <mu2>0.9</mu2>
    </gazebo>
    <gazebo reference="${name}_6_link">
      <mu1>0.9</mu1>
      <mu2>0.9</mu2>
    </gazebo>
    <gazebo reference="${name}_7_link">
      <mu1>0.9</mu1>
      <mu2>0.9</mu2>
    </gazebo>
    
    <gazebo reference="${name}_1_joint">
      <implicitSpringDamper>1</implicitSpringDamper>
    </gazebo>
    <gazebo reference="${name}_2_joint">
      <implicitSpringDamper>1</implicitSpringDamper>
    </gazebo>
    <gazebo reference="${name}_3_joint">
      <implicitSpringDamper>1</implicitSpringDamper>
    </gazebo>
    <gazebo reference="${name}_4_joint">
      <implicitSpringDamper>1</implicitSpringDamper>
    </gazebo>
    <gazebo reference="${name}_5_joint">
      <implicitSpringDamper>1</implicitSpringDamper>
    </gazebo>
    <gazebo reference="${name}_6_joint">
      <implicitSpringDamper>1</implicitSpringDamper>
    </gazebo>
    <gazebo reference="${name}_7_joint">
      <implicitSpringDamper>1</implicitSpringDamper>
      <provideFeedback>1</provideFeedback>
    </gazebo>

    <!-- TRANSMISSIONS -->
    <xacro:arm_simple_transmission name="${name}" number="1" reduction="1.0" offset_value="${arm_1_offset}"/>
    <xacro:arm_simple_transmission name="${name}" number="2" reduction="1.0" offset_value="${arm_2_offset}"/>
    <xacro:arm_simple_transmission name="${name}" number="3" reduction="1.0" offset_value="${arm_3_offset}"/>
    <xacro:arm_simple_transmission name="${name}" number="4" reduction="1.0" offset_value="${arm_4_offset}"/>
    <xacro:arm_simple_transmission name="${name}" number="5" reduction="1.0" offset_value="${arm_5_offset}"/>
    <xacro:arm_simple_transmission name="${name}" number="6" reduction="1.0" offset_value="${arm_6_offset}"/>
    <xacro:arm_simple_transmission name="${name}" number="7" reduction="1.0" offset_value="${arm_7_offset}"/>
  </xacro:macro>
</robot>
