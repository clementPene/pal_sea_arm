<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <arg name="end_effector"  default="pal-pro-gripper"/>
    <arg name="ft_sensor"  default="false"/>

    <include file="$(find pal_sea_arm_controller_configuration)/launch/joint_state_controller.launch"/>
    <include file="$(find pal_sea_arm_controller_configuration)/launch/default_controllers.launch"/>
    <group if="$(eval ft_sensor == 'rokubi')">
      <include file="$(find tiago_controller_configuration)/launch/force_torque_controller.launch"/>
    </group>


    <group if="$(eval end_effector == 'pal-pro-gripper')">
        <rosparam command="load" file="$(find pal_pro_gripper_controller_configuration)/config/joint_trajectory_controllers.yaml" />
        <include file="$(find pal_pro_gripper_controller_configuration)/launch/gripper_controller.launch"/>
    </group>

    <!-- Motion planning -->
    <include file="$(find pal_sea_arm_moveit_config)/launch/move_group.launch">
      <arg name="end_effector" value="$(arg end_effector)"/>
      <arg name="ft_sensor" value="$(arg ft_sensor)"/>
      <arg name="capabilities" value="move_group/CapabilityLoader"/>
    </include>
</launch>
