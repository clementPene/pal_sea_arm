<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="end_effector"  default="pal-pro-gripper"/>
  <arg name="ft_sensor"  default="false"/>
  <arg name="no_safety_eps" default="False"/>
  <arg name="robot_namespace" default=""/>

  <!-- Robot model -->
  <include file="$(find pal_sea_arm_description)/robots/upload.launch">
    <arg name="end_effector"  value="$(arg end_effector)"/>
    <arg name="ft_sensor"  value="$(arg ft_sensor)"/>
    <arg name="arm_model" default="pal-sea-arm-standalone"/>
    <arg name="no_safety_eps"  value="$(arg no_safety_eps)"/>
  </include>

  <!-- tiago_hardware parameters -->
  <arg name="file_suffix" value="$(eval (((end_effector if end_effector else 'no-ee') + ('_' +  ft_sensor if ft_sensor else '')))"/>  
  <rosparam command="load" file="$(find pal_sea_arm_bringup)/config/pal_sea_arm_hardware/pal_sea_arm_hardware_$(arg file_suffix).yaml"/>

  <!-- Bring up robot -->
  <include file="$(find pal_sea_arm_bringup)/launch/pal_sea_arm_bringup.launch">
    <arg name="end_effector"  value="$(arg end_effector)"/>
    <arg name="ft_sensor"  value="$(arg ft_sensor)"/>
    <param name="tf_prefix" type="string" value="$(arg robot_namespace)"/>
  </include>
</launch>
