<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="end_effector"/>
  <arg name="ft_sensor"/>

<!-- TODO: Create new motions for play motion -->
  <arg name="file_suffix" value="$(eval ((end_effector if end_effector else 'no-ee') + ('_' +  ft_sensor if ft_sensor else '')))"/>  
  <!-- execute pre-recorded motions -->
  <rosparam if="$(eval end_effector != 'custom')" file="$(find pal_sea_arm_bringup)/config/motions/pal_sea_arm_motions_$(arg file_suffix).yaml" command="load" />
  <rosparam if="$(eval end_effector == 'custom')" file="$(find custom_ee_configuration)/config/motions/tiago_motions.yaml" command="load" />
  <node pkg="play_motion" type="play_motion" name="play_motion">
    <rosparam if="$(eval end_effector != 'custom')" file="$(find pal_sea_arm_bringup)/config/approach_planner/approach_planner_$(arg file_suffix).yaml" command="load" />
    <rosparam if="$(eval end_effector == 'custom')" file="$(find custom_ee_configuration)/config/approach_planner/approach_planner.yaml" 
    command="load" />
  </node>
  <node pkg="play_motion" type="is_already_there.py" name="is_already_there" />
</launch>
