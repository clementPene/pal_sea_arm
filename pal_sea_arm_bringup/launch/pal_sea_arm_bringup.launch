<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="end_effector"  default="pal-pro-gripper"/>
  <arg name="ft_sensor"  default="false"/>
  <arg name="robot_namespace" default=""/>

  <!-- Load default controllers -->
  <include file="$(find pal_sea_arm_controller_configuration)/launch/pal_sea_arm_controllers.launch">
    <arg name="end_effector" value="$(arg end_effector)"/>
    <arg name="ft_sensor" value="$(arg ft_sensor)"/>>
  </include>

  <!-- Robot state publisher -->
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher">
    <param name="publish_frequency" type="double" value="50.0"/>
    <param name="tf_prefix" type="string" value="$(arg robot_namespace)"/>
    <param name="use_tf_static" type="bool" value="true"/>
  </node>

  <!-- TF lookup -->
  <node pkg="tf_lookup" type="tf_lookup" name="tf_lookup" output="screen"/>

  <!-- Twist mux -->
  <include file="$(find pal_sea_arm_bringup)/launch/twist_mux.launch">
  </include>

  <!-- Joystick controller -->
  <include file="$(find pal_sea_arm_bringup)/launch/joystick_teleop.launch">
    <arg name="end_effector" value="$(arg end_effector)"/>
    <arg name="ft_sensor" value="$(arg ft_sensor)"/>
  </include>

</launch>
