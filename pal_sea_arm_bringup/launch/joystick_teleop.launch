<launch>
  <arg name="arm"  default="True"/>
  <arg name="end_effector"  default="pal-pro-gripper"/>
  <arg name="ft_sensor"  default="false"/>

  <arg name="input_device" default="/dev/joystick"/>
  <arg name="cmd_vel" default="input_joy/cmd_vel" />
  <arg name="file_suffix" value="$(eval ((end_effector if end_effector else 'no-ee') + ('_' +  ft_sensor if ft_sensor else '')))"/>  
  
  <arg name="teleop_config" default="$(find pal_sea_arm_bringup)/config/joy_teleop/joy_teleop_$(arg file_suffix).yaml" />

  <rosparam file="$(arg teleop_config)" command="load" />
  <node pkg="joy_teleop" type="joy_teleop.py" name="joy_teleop">
    <remap from="cmd_vel" to="$(arg cmd_vel)" />
  </node>

  <node pkg="joy" type="joy_node" name="joystick">
    <param name="autorepeat_rate" value="10" />
    <param name="dev" value="$(arg input_device)" />
  </node>

  <group ns="gripper_controller" if="$(eval end_effector in ['pal-pro-gripper'])">
    <node pkg="joy_teleop" type="incrementer_server" name="incrementer"/>
  </group>
</launch>
