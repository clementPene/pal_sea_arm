<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="ft_sensor" params="name parent reflect">
    <!--************************-->
    <!--        ft sensor       -->
    <!--************************-->
    <link name="${name}_ft_link">
        <inertial>
          <mass value="0.2657" />
          <inertia ixx="268925.36" ixy="3102.05" ixz="5074.07" iyy="160140.92" iyz="4096.6" izz="268336.32" />
        </inertial>
        <visual>
          <origin xyz="0.0 0.0 -0.050" rpy="${90.0 * deg_to_rad} 0 ${45.0 * deg_to_rad if reflect == '1' else 135 * deg_to_rad}"/>
          <geometry>
            <mesh filename="package://tiago_sea_arm_description/meshes/sensors/ati_ft_sensor.STL"/>
          </geometry>
          <material name="">
            <color rgba="0.752941176470588 0.752941176470588 0.752941176470588 1" />
          </material>
        </visual>
        <collision>
          <origin xyz="0 0 -0.025" rpy="0 0 0" />
          <geometry>
            <cylinder radius="0.035" length="0.05"/>
          </geometry>
        </collision>
        <collision>
          <origin xyz="0.047 0 -0.040" rpy="0 0 0" />
          <geometry>
            <box size="0.025 0.012 0.04"/>
          </geometry>
        </collision>
    </link>

    <joint name="${name}_ft_joint" type="fixed">
      <parent link="${parent}" />
      <child link="${name}_ft_link" />
      <origin xyz="0.050 0 0" rpy="${-90.0 * deg_to_rad} ${45.0 * deg_to_rad} ${-90.0 * deg_to_rad}" />
    </joint>

    <!--***********************-->
    <!--       FT TOOL         -->
    <!--***********************-->
    <link name="${name}_ft_tool_link"/>

    <joint name="${name}_ft_tool_joint" type="fixed">
      <parent link="${name}_ft_link" />
      <child link="${name}_ft_tool_link" />
      <origin xyz="0 0 0.0" rpy="${45.0 * deg_to_rad} ${-90.0 * deg_to_rad} ${0.0 * deg_to_rad}" />
    </joint>

</xacro:macro>

</robot>
