<robot xmlns:xacro="http://ros.org/wiki/xacro" name="tiago_sea_arm">
  <xacro:include filename="$(find tiago_sea_arm_description)/urdf/arm/arm.urdf.xacro"/>
  <xacro:include filename="$(find tiago_sea_arm_description)/urdf/end_effector/end_effector.urdf.xacro"/>

  <xacro:arg name="end_effector" default="false"/>
  <xacro:arg name="ft_sensor" default="false"/>
  <xacro:property name="end_effector" value="$(arg end_effector)" />
  <xacro:property name="ft_sensor" value="$(arg ft_sensor)" />

  <!-- BASE LINK -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://tiago_sea_arm_description/meshes/base_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://tiago_sea_arm_description/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <!-- ARM -->
  <xacro:tiago_sea_arm name="arm_right" parent="base_link" reflect="1" ft_sensor="${ft_sensor}" arm_1_offset="0" arm_2_offset="0" arm_3_offset="0" arm_4_offset="0" arm_5_offset="0" arm_6_offset="0" arm_7_offset="0"/>

  <xacro:tiago_sea_arm_end_effector name="gripper" parent="arm_right_7_link" type="${end_effector}"/>

</robot>
